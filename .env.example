# .env.example 을 .env 로 복사해 값을 채운다. .env 는 .gitignore 라 커밋되지 않는다.
# 공공데이터포털 일반 인증키 (응급의료기관·행정동 인구 API 공용, Encoding/Decoding 어느 쪽이든 됨)
# 이름은 DATA_GO_KR_SERVICE_KEY 를 쓰고, 없으면 KR_SERVICE_KEY 도 읽는다 (둘 다 있으면 DATA_GO_KR_SERVICE_KEY 우선)
DATA_GO_KR_SERVICE_KEY=
# 카카오 디벨로퍼스 REST API 키 (카카오맵 사용 설정 필요, 행정복지센터·리 좌표)
KAKAO_REST_API_KEY=
